@page "{id:int}"
@model Books_Management_System.Pages.Books.DeleteModel

<h2>Delete Book</h2>

@if (Model.Book != null)
{
    <div class="alert alert-warning" role="alert">
        Are you sure you want to delete this book? This action cannot be undone.
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Book.title</dd>

        <dt class="col-sm-2">Author</dt>
        <dd class="col-sm-10">@Model.Book.author</dd>

        <dt class="col-sm-2">Publisher</dt>
        <dd class="col-sm-10">@Model.Book.publisher</dd>

        <dt class="col-sm-2">Category</dt>
        <dd class="col-sm-10">@Model.Book.category</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Book.Id" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
}
else
{
    <div class="alert alert-danger" role="alert">
        Book not found.
    </div>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
}